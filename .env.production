# 生产构建配置。EdgeOne 控制台的环境变量为空，构建时读的就是这个文件。

# 后端接口地址。留空时 api.js 回落到同源 /api，
# 不会像以前那样把开发用的 localhost:3000 打进生产产物。
VITE_API_BASE_URL=

# 站点规范地址，用于预渲染页面的 canonical / og:url 与 sitemap
VITE_SITE_URL=https://xn--vqqq8jxym.com

# 广告接口开关，接口未上线时保持 false，广告位只展示本站加群卡片
VITE_ADS_ENABLED=false

# QQ 群加群链接，留空则广告位不渲染
VITE_QQ_GROUP_URL=https://qm.qq.com/q/hBcOiafEti
