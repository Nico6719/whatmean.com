# demo 站构建配置（demo.何意味.com）
# 与主站的差别只有两处：站点地址和 noindex 开关。

# 后端接口地址。留空时 api.js 回落到同源 /api。
VITE_API_BASE_URL=

# demo 站自己的规范地址，避免 canonical 指到生产站
VITE_SITE_URL=https://xn--vqqq8jxym.com

# 广告接口开关，接口未上线时保持 false，广告位只展示本站加群卡片
VITE_ADS_ENABLED=false

# QQ 群加群链接，留空则广告位不渲染
VITE_QQ_GROUP_URL=https://qm.qq.com/q/hBcOiafEti

# demo 站整站 noindex：与主站输出逐字相同的 48 个词条页，
# 不隔离会互为重复内容，搜索引擎可能保留 demo 而丢掉主站。
VITE_NOINDEX=false
